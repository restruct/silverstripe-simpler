{
    "name": "restruct/silverstripe-simpler",
    "type": "silverstripe-vendormodule",
    "description": "Opt-in helpers for simpler Silverstripe CMS admin development: Vue 3 via an import map, a Bootstrap modal from JS or PHP, GridField modal and toggle buttons, an edit-protected text field, DOM events for AJAX-loaded content and static session helpers",
    "keywords": [
        "silverstripe",
        "silverstripe-module",
        "silverstripe-cms",
        "admin",
        "vue",
        "vue3",
        "import-map",
        "modal",
        "bootstrap",
        "gridfield"
    ],
    "license": "MIT",
    "authors": [ { "name": "Restruct", "email": "dev@restruct.nl", "homepage": "https://restruct.nl" } ],
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^5 || ^6"
    },
    "suggest": {
        "lekoala/silverstripe-pure-modal": "Required for SimplerModalField and SimplerModalAction (^1.2 on Silverstripe 5, ^2 on Silverstripe 6)"
    },
    "autoload": {
        "psr-4": {
            "Restruct\\Silverstripe\\Simpler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Restruct\\Silverstripe\\Simpler\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^3 || ^4"
    },
    "extra": {
        "expose": [
            "client/dist"
        ],
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/restruct"
        }
    ]
}
